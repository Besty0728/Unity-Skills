+def _object_identity(rec):
+    value = rec.get("entityId")
+    if value in (None, ""):
+        value = rec.get("instanceId")
+    return None if value in (None, "") else str(value)
+
+
+def _object_location_observation(rec):
+    """Trusted location evidence for later pathless destruction records.
+
+    A create proves that the attempt introduced this identity at path. A reparent proves its new
+    current path. Other records may mention an identity and path, but do not prove creation or a
+    move and therefore cannot make an otherwise unknown destruction safe.
+    """
+    kind = rec.get("kind")
+    if kind == "gameobject_created":
+        return rec.get("path")
+    if kind == "gameobject_reparented":
+        return rec.get("toPath")
+    return None
+
+
 def scope_violations(records, object_root, asset_root, run_scene=None, extra_allowed=None):
     """Changes outside the run's object/asset roots (meta files follow their asset)."""
