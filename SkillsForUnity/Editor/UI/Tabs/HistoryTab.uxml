<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements"
         editor="UnityEditor.UIElements"
         noNamespaceSchemaLocation="../../../../../../../UIElementsSchema/UIElementsSchema.xsd">

    <ui:VisualElement class="history-root">

        <!-- Toolbar -->
        <ui:VisualElement name="history-toolbar" class="history-toolbar">
            <ui:Label name="history-title" class="bold-label" text="Workflow History" />
            <ui:VisualElement class="history-toolbar__spacer" />
            <ui:Toggle name="auto-checkpoint-toggle" class="history-toolbar__toggle" />
            <ui:Button name="refresh-btn" class="mini-btn" tooltip="Refresh" />
            <ui:Button name="clear-btn" class="mini-btn danger" text="Clear History" />
        </ui:VisualElement>

        <!-- Cache warning, then the result of the last action -->
        <ui:HelpBox name="cache-warning" message-type="Warning" class="history-cache-warning" />
        <ui:Button name="undo-restore-btn" class="mini-btn history-undo-btn" />

        <!-- Auto Clean and checkpoint settings -->
        <ui:Foldout name="autoclean-foldout" value="false" class="history-autoclean">
            <ui:Toggle name="autoclean-enabled" />
            <ui:VisualElement name="autoclean-fields">
                <ui:IntegerField name="autoclean-capacity-mb" />
                <ui:IntegerField name="autoclean-max-age" />
            </ui:VisualElement>
            <ui:IntegerField name="history-idle-gap" />
            <ui:Label name="autoclean-usage" class="muted-label autoclean-usage" />
            <ui:VisualElement name="autoclean-legacy-row" class="autoclean-legacy-row">
                <ui:Label name="autoclean-legacy-label" class="muted-label" />
                <ui:Button name="autoclean-legacy-delete-btn" class="mini-btn" />
            </ui:VisualElement>
            <ui:VisualElement class="autoclean-actions">
                <ui:Button name="autoclean-run-btn" class="mini-btn" />
                <ui:Button name="autoclean-reset-btn" class="mini-btn" />
            </ui:VisualElement>
        </ui:Foldout>

        <!-- Timeline body -->
        <ui:VisualElement class="history-body">
            <ui:DropdownField name="history-agent-filter" class="history-agent-filter" />
            <ui:ListView name="timeline-list" class="timeline-list" />

            <!-- Restore preview, shown after a checkpoint's Preview button -->
            <ui:VisualElement name="restore-preview" class="restore-preview">
                <ui:Label name="summary-label" class="restore-preview__summary" />
                <ui:Label name="conflicts-title" class="muted-label restore-preview__conflicts-title" />
                <ui:VisualElement name="conflict-list" class="conflict-list" />
                <ui:HelpBox name="coverage-warning" message-type="Warning" class="restore-preview__coverage" />
                <ui:Label name="unresolvable-label" class="muted-label" />
                <ui:VisualElement class="restore-preview__actions">
                    <ui:Button name="preview-cancel-btn" class="mini-btn" />
                    <ui:Button name="preview-restore-btn" class="mini-btn install" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
