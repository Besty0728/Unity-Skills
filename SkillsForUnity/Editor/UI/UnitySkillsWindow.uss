/* =====================================================================
 * UnitySkills Global Theme stylesheet — v2 layout
 *
 * Layout principle: structural flex (direction / shrink / grow) is written
 * INLINE in UXML as a safety net. USS handles theming (colors, fonts,
 * transitions, hover states, animations). This avoids the entire UI
 * collapsing if a USS class fails to apply due to load order or asset
 * cache issues.
 *
 * Trap: UXML inline style="..." cannot use var(--xxx). CloneTree resolves
 * inline styles before the element is attached to the tree, so external
 * stylesheet variables aren't visible yet and StyleVariableResolver throws
 * NullReferenceException. Always reference variables from USS classes only.
 *
 * v2 changes:
 *  - Topbar: status dot + url pill + server toggle + status text + settings
 *  - Tabs: Skills / AI Config / History / Analytics
 *  - Skills layout: master-detail (list left, detail right)
 *  - AIConfig: 4 brand cards + custom; PNG icon via Image
 *  - Settings moved into right-side drawer (slide-in)
 *  - Footer: version + live stats pill + segmented language switch
 * ===================================================================== */

/* ---------- Theme Variables — Dark (default) ---------- */
:root {
    --color-bg: #1e1f22;
    --color-chrome-bg: #17181a;
    --color-panel: #232428;
    --color-card-bg: #2a2b30;
    --color-card-bg-hover: #303238;
    --color-card-bg-selected: #284a78;
    --color-card-header-bg: #2e3035;
    --color-card-border: #35373e;
    --color-border-hard: #111214;

    --color-tab-hover-bg: rgba(255, 255, 255, 0.05);

    --color-success: #5cc98a;
    --color-success-hover: #74d59c;
    --color-error: #ee6f6f;
    --color-error-hover: #f38989;
    --color-warning: #e6b450;
    --color-warning-hover: #edc26e;
    --color-warning-text: #ecd29a;
    --color-accent: #5b9bff;
    --color-accent-hover: #77acff;
    --color-accent-dark: #2f66c7;
    --color-accent-text: #8eb8ff;
    --color-muted: #9398a2;
    --color-danger-dark: #ee6f6f;
    --color-danger-darker: #ee6f6f;

    --color-tint-accent: rgba(91, 155, 255, 0.14);
    --color-tint-accent-border: rgba(91, 155, 255, 0.38);
    --color-tint-success: rgba(92, 201, 138, 0.14);
    --color-tint-success-border: rgba(92, 201, 138, 0.36);
    --color-tint-error: rgba(238, 111, 111, 0.13);
    --color-tint-error-border: rgba(238, 111, 111, 0.4);
    --color-tint-warning: rgba(230, 180, 80, 0.12);
    --color-tint-warning-border: rgba(230, 180, 80, 0.34);

    --color-text: #e4e5e8;
    --color-text-hover: #ffffff;
    --color-text-secondary: #b6b9c0;
    --color-text-tab-idle: #a9adb5;
    --color-text-on-accent: #ffffff;

    --color-button-bg: #2f3136;
    --color-button-hover: #3a3d43;
    --color-input-bg: #18191c;
    --color-input-border: #393b42;
    --color-input-focus: #5b9bff;
    --color-drawer-bg: #1e1f22;
}

/* ---------- Theme Variables — Light ---------- */
.unity-theme-light :root,
.unity-theme-light {
    --color-bg: #e4e6e9;
    --color-chrome-bg: #d7d9dd;
    --color-panel: #eceef0;
    --color-card-bg: #f6f7f8;
    --color-card-bg-hover: #e8ebef;
    --color-card-bg-selected: #cfe0fb;
    --color-card-header-bg: #eef0f3;
    --color-card-border: #cfd3d9;
    --color-border-hard: #b4b9c1;

    --color-tab-hover-bg: rgba(0, 0, 0, 0.05);

    --color-success: #1f8a4c;
    --color-success-hover: #26a159;
    --color-error: #c53a3a;
    --color-error-hover: #d44b4b;
    --color-warning: #9a6a00;
    --color-warning-hover: #b07a00;
    --color-warning-text: #6b4a00;
    --color-accent: #2563d9;
    --color-accent-hover: #3a74e2;
    --color-accent-dark: #1f54ba;
    --color-accent-text: #1f54ba;
    --color-muted: #61666f;
    --color-danger-dark: #c53a3a;
    --color-danger-darker: #c53a3a;

    --color-tint-accent: rgba(37, 99, 217, 0.1);
    --color-tint-accent-border: rgba(37, 99, 217, 0.35);
    --color-tint-success: rgba(31, 138, 76, 0.1);
    --color-tint-success-border: rgba(31, 138, 76, 0.35);
    --color-tint-error: rgba(197, 58, 58, 0.08);
    --color-tint-error-border: rgba(197, 58, 58, 0.4);
    --color-tint-warning: rgba(154, 106, 0, 0.1);
    --color-tint-warning-border: rgba(154, 106, 0, 0.35);

    --color-text: #1e2024;
    --color-text-hover: #000000;
    --color-text-secondary: #464b53;
    --color-text-tab-idle: #50555d;
    --color-text-on-accent: #ffffff;

    --color-button-bg: #ffffff;
    --color-button-hover: #eef0f3;
    --color-input-bg: #ffffff;
    --color-input-border: #c3c7cd;
    --color-input-focus: #2563d9;
    --color-drawer-bg: #e4e6e9;
}

/* ---------- Root Container ---------- */
.root {
    background-color: var(--color-bg);
}

/* ---------- Generic Layout Helpers ---------- */
.scroll-view {
    flex-grow: 1;
}

.horizontal-layout {
    flex-direction: row;
    align-items: center;
}

.flex-grow {
    flex-grow: 1;
}

/* Single shared show/hide mechanism (see UiVisibility.SetVisible). Toggling this class is the
 * only sanctioned way to hide an element with plain Flex/None semantics; nothing should write
 * element.style.display directly for a site that uses it. */
.is-hidden {
    display: none;
}

/* Static, never-varying layout for rows/cards built programmatically in C# (AllowlistPickerWindow,
 * AIConfigTabController, HistoryTabController, SettingsDrawerController). Kept generic so callers
 * needing a different constant simply add a modifier class instead of writing style.X in C#.
 * A flexGrow:1 label/field in one of these rows reuses the existing .flex-grow helper above. */
.built-row {
    flex-direction: row;
    align-items: center;
}

.built-card {
    flex-direction: column;
    margin-bottom: 4px;
}

/* One-off spacing modifiers for a couple of specific programmatically-built rows -
 * kept separate from .built-row so a differing constant never has to fork the base rule. */
.setting-row--gap-top {
    margin-top: 4px;
}

.mini-btn--inline-gap {
    margin-left: 4px;
}

.mini-btn--right-gap {
    margin-right: 4px;
}

/* ShortcutsSettingsController.BuildCaptureRow - the outer capture container and the
 * .setting-row nested inside it need constants .built-card / .setting-row don't already provide. */
.shortcut-capture-row {
    flex-direction: column;
    margin-bottom: 6px;
}

.setting-row--flush-bottom {
    margin-bottom: 0;
}

/* SettingsDrawerController.BuildPendingRow / BuildAllowlistRow - the two programmatically-built
 * permission-panel row shapes share this title styling. */
.card-row__title {
    flex-grow: 1;
    font-size: 11px;
}

.pending-row__expires {
    margin-top: 0;
    margin-bottom: 0;
}

.pending-row__note {
    margin-bottom: 2px;
}

.pending-row__args {
    margin-top: 2px;
    margin-bottom: 4px;
}

.pending-row__actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 2px;
}

.allowlist-row {
    margin-bottom: 2px;
}

.allowlist-foldout {
    margin-top: 2px;
}

/* ===================================================================
 * 1. TOPBAR — persistent server status & quick actions
 * =================================================================== */
.topbar {
    background-color: var(--color-chrome-bg);
    height: 36px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border-hard);
    padding: 0 8px;
    min-width: 0;
    position: relative;
    /* Space the narrow-layout perm badge must leave clear on its right so it never
     * overlaps the absolutely positioned settings button (see .topbar--narrow >
     * .topbar-settings-btn below: right 8px + width 28px = 36px, +4px buffer). */
    --topbar-settings-reserve: 40px;
}

.topbar-actions {
    flex-shrink: 0;
    margin-left: auto;
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
}

.topbar-settings-btn {
    width: 28px;
    min-width: 28px;
    max-width: 28px;
    flex-shrink: 0;
    margin-left: 4px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.topbar > .topbar-settings-btn {
    margin-left: 4px;
}

/* Draw the settings gear from UI Toolkit geometry. Unity 2022's editor icon
 * texture is a low-resolution bitmap and becomes blurry when scaled. */
.settings-icon {
    width: 18px;
    height: 18px;
    position: relative;
    flex-shrink: 0;
    align-self: center;
}

.settings-icon__ring {
    position: absolute;
    left: 3px;
    top: 3px;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    border-width: 3px;
    border-color: var(--color-text);
    background-color: transparent;
}

.settings-icon__hub {
    position: absolute;
    left: 7px;
    top: 7px;
    width: 4px;
    height: 4px;
    border-radius: 2px;
    border-width: 2px;
    border-color: var(--color-text);
    background-color: transparent;
}

.settings-icon__tooth {
    position: absolute;
    width: 4px;
    height: 6px;
    background-color: var(--color-text);
    border-radius: 1px;
}

.settings-icon__tooth--top { left: 8px; top: 0; }
.settings-icon__tooth--top-right { left: 12px; top: 1px; rotate: 45deg; }
.settings-icon__tooth--right { left: 15px; top: 6px; rotate: 90deg; }
.settings-icon__tooth--bottom-right { left: 12px; top: 11px; rotate: 135deg; }
.settings-icon__tooth--bottom { left: 8px; top: 12px; rotate: 180deg; }
.settings-icon__tooth--bottom-left { left: 3px; top: 11px; rotate: 225deg; }
.settings-icon__tooth--left { left: 0; top: 6px; rotate: 270deg; }
.settings-icon__tooth--top-left { left: 3px; top: 1px; rotate: 315deg; }

/* Once the URL pill is removed, take the fixed control group out of the
 * shrinking row and anchor it to the topbar's right edge. */
.topbar--narrow .topbar-actions {
    flex-grow: 1;
    min-width: 0;
    padding-left: 8px;
    padding-right: 4px;
    justify-content: flex-start;
    background-color: transparent;
}

.topbar--narrow > .topbar-settings-btn {
    position: absolute;
    right: 8px;
    top: 6px;
    margin-left: 0;
}

.status-dot {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 8px;
    background-color: var(--color-muted);
}

.status-dot.success {
    background-color: var(--color-success);
}

.status-dot.error {
    background-color: var(--color-error);
}

.status-dot.warn {
    background-color: var(--color-warning);
}

.url-pill {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    max-width: 9999px;
    height: 22px;
    background-color: var(--color-input-bg);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 2px;
    padding: 0 4px 0 8px;
    margin: 0 6px;
}

.url-pill__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: var(--color-text-secondary);
    font-size: 11px;
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
}

.url-pill__text > .unity-text-field__input,
.url-pill__text > .unity-base-text-field__input,
.url-pill__text > .unity-base-field__input {
    min-width: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--color-text-secondary);
    font-size: 11px;
    padding: 0;
    margin: 0;
}

.url-pill__copy {
    flex-shrink: 0;
    min-width: 58px;
    height: 16px;
    margin: 0 0 0 4px;
    padding: 0 6px;
    font-size: 10px;
    background-color: var(--color-button-bg);
    border-width: 1px;
    border-color: var(--color-border-hard);
    border-radius: 2px;
    color: var(--color-text);
}

.url-pill__copy:hover {
    background-color: var(--color-button-hover);
}

/* Server Toggle Switch — slider style (uiverse adaptation) */
.server-switch {
    flex-shrink: 0;
    width: 32px;
    height: 18px;
    margin: 0 6px 0 4px;
    align-items: center;
    background-color: var(--color-button-bg);
    border-width: 1px;
    border-color: var(--color-border-hard);
    border-radius: 9px;
    transition-property: background-color, border-color;
    transition-duration: 0.32s;
}

.server-switch__knob {
    width: 14px;
    height: 14px;
    margin-left: 1px;
    background-color: #f0f0f0;
    border-radius: 7px;
    transition-property: translate, background-color;
    transition-duration: 0.32s;
    transition-timing-function: ease-out;
    translate: 0 0;
}

.server-switch.on {
    background-color: var(--color-accent);
    border-color: var(--color-accent-dark);
}

.server-switch.on .server-switch__knob {
    translate: 14px 0;
}

.server-switch.starting {
    background-color: var(--color-warning);
    border-color: var(--color-warning);
}

/* Universal Blue Toggle Switch for settings and custom toggles (valid standard USS syntax) */
.setting-toggle,
.token-level-toggle,
.cli-feature-toggle,
.settings-group > .unity-toggle,
.setting-row > .unity-toggle {
    margin: 2px 0;
}

.setting-toggle .unity-toggle__input,
.token-level-toggle .unity-toggle__input,
.cli-feature-toggle .unity-toggle__input,
.settings-group > .unity-toggle .unity-toggle__input,
.setting-row > .unity-toggle .unity-toggle__input {
    flex-grow: 0;
    flex-shrink: 0;
    width: 32px;
    height: 18px;
    align-items: center;
    background-color: var(--color-button-bg);
    border-width: 1px;
    border-color: var(--color-border-hard);
    border-radius: 9px;
    margin: 0;
    padding: 0;
    cursor: link;
    transition-property: background-color, border-color;
    transition-duration: 0.22s;
}

.setting-toggle .unity-toggle__checkmark,
.token-level-toggle .unity-toggle__checkmark,
.cli-feature-toggle .unity-toggle__checkmark,
.settings-group > .unity-toggle .unity-toggle__checkmark,
.setting-row > .unity-toggle .unity-toggle__checkmark {
    width: 14px;
    height: 14px;
    margin-left: 1px;
    background-color: #f0f0f0;
    border-radius: 7px;
    border-width: 0;
    background-image: none;
    -unity-background-image-tint-color: transparent;
    transition-property: translate, background-color;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
    translate: 0 0;
}

.setting-toggle:checked .unity-toggle__input,
.token-level-toggle:checked .unity-toggle__input,
.cli-feature-toggle:checked .unity-toggle__input,
.settings-group > .unity-toggle:checked .unity-toggle__input,
.setting-row > .unity-toggle:checked .unity-toggle__input {
    background-color: var(--color-accent);
    border-color: var(--color-accent-dark);
}

.setting-toggle:checked .unity-toggle__checkmark,
.token-level-toggle:checked .unity-toggle__checkmark,
.cli-feature-toggle:checked .unity-toggle__checkmark,
.settings-group > .unity-toggle:checked .unity-toggle__checkmark,
.setting-row > .unity-toggle:checked .unity-toggle__checkmark {
    translate: 14px 0;
    background-color: #ffffff;
    background-image: none;
    -unity-background-image-tint-color: transparent;
}

.setting-toggle:hover .unity-toggle__input,
.token-level-toggle:hover .unity-toggle__input,
.cli-feature-toggle:hover .unity-toggle__input,
.settings-group > .unity-toggle:hover .unity-toggle__input,
.setting-row > .unity-toggle:hover .unity-toggle__input {
    border-color: var(--color-accent);
}

.server-status-text {
    flex-shrink: 0;
    min-width: 46px;
    height: 18px;
    margin-right: 4px;
    padding: 0 8px;
    font-size: 10px;
    color: var(--color-text-secondary);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    border-radius: 10px;
}

.server-status-text.on  { background-color: var(--color-tint-success); color: var(--color-success); }
.server-status-text.off { color: var(--color-muted); }

#perm-mode-badge {
    flex-shrink: 0;
    overflow: hidden;
    white-space: nowrap;
    border-radius: 12px;
}

#perm-mode-badge.perm-mode-badge--fallback {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 76px;
    min-width: 76px;
    max-width: 76px;
    padding: 0 6px;
}

#perm-mode-badge.perm-mode-badge--fallback .perm-mode-badge__dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 4px;
    background-color: var(--color-muted);
}

#perm-mode-badge.perm-mode-badge--fallback .perm-mode-badge__label {
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    font-size: 10px;
    color: var(--color-text);
    -unity-text-align: middle-left;
    overflow: hidden;
    white-space: nowrap;
}

#perm-mode-badge.perm-mode-badge--fallback.perm-mode-badge--approval .perm-mode-badge__dot {
    background-color: var(--color-warning);
}

#perm-mode-badge.perm-mode-badge--fallback.perm-mode-badge--auto .perm-mode-badge__dot {
    background-color: var(--color-accent);
}

#perm-mode-badge.perm-mode-badge--fallback.perm-mode-badge--bypass .perm-mode-badge__dot {
    background-color: #18d59a;
}

.topbar--compact .url-pill {
    flex-grow: 0;
    flex-shrink: 0;
    width: 70px;
    padding-left: 3px;
    padding-right: 3px;
    margin: 0 4px;
}

.topbar--compact .url-pill__text {
    display: none;
}

.topbar--compact .url-pill__copy {
    margin-left: 0;
}

.topbar--compact .server-switch {
    margin: 0 4px 0 2px;
}

.topbar--compact .server-status-text {
    min-width: 42px;
    margin-right: 2px;
}

.topbar--compact #perm-mode-badge {
    width: 70px;
    min-width: 70px;
    max-width: 70px;
}

.topbar--compact #perm-mode-badge.perm-mode-badge--native {
    width: auto;
    min-width: 0;
    max-width: none;
}

.topbar--narrow .url-pill {
    display: none;
}

.topbar--narrow #perm-mode-badge {
    margin-left: auto;
    /* Must clear the absolutely positioned .topbar-settings-btn (see .topbar's
     * --topbar-settings-reserve declaration above). */
    margin-right: var(--topbar-settings-reserve);
}

.topbar--narrow .server-switch {
    margin-left: 0;
}

/* Icon button (gear, close, etc.) */
.icon-btn {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
    color: var(--color-text-secondary);
    -unity-text-align: middle-center;
}

.icon-btn:hover {
    background-color: var(--color-button-bg);
    border-color: var(--color-border-hard);
    color: var(--color-text);
}

/* ===================================================================
 * 2. TAB BAR — registry-driven horizontal strip with symmetric scroll buttons
 * =================================================================== */
.tab-bar-container {
    flex-shrink: 0;
    min-width: 0;
    height: 32px;
    /* Pinned to the pre-Graphite palette; custom properties inherit, so tab children keep the old look. */
    --color-panel: #2a2a2a;
    --color-border-hard: #1a1a1a;
    --color-text-secondary: #a0a0a0;
    --color-text-tab-idle: #a0a0a0;
    --color-text-hover: #ffffff;
    --color-tab-hover-bg: rgba(255, 255, 255, 0.06);
    --color-accent: #4a9eff;
    --color-accent-hover: #5cacff;
    background-color: var(--color-panel);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border-hard);
}

.unity-theme-light .tab-bar-container {
    --color-panel: #d4d4d4;
    --color-border-hard: #888888;
    --color-text-secondary: #555555;
    --color-text-tab-idle: #555555;
    --color-text-hover: #000000;
    --color-tab-hover-bg: rgba(0, 0, 0, 0.06);
    --color-accent: #0066cc;
    --color-accent-hover: #1f7ad8;
}

.tab-scroll-arrow-btn {
    flex-shrink: 0;
    width: 20px;
    height: 28px;
    margin: 0 1px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 4px;
    justify-content: center;
    align-items: center;
    cursor: link;
    transition-property: background-color, opacity;
    transition-duration: 0.12s;
}

.tab-scroll-arrow-btn:hover {
    background-color: var(--color-tab-hover-bg);
}

.tab-scroll-arrow-btn:disabled {
    opacity: 0.25;
}

.tab-scroll-arrow-icon {
    width: 8px;
    height: 10px;
}

.tab-bar-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 32px;
    background-color: rgba(0, 0, 0, 0);
}

.tab-bar-scroll .unity-scroll-view__content-viewport {
    min-width: 0;
    overflow: hidden;
}

.tab-bar-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    flex-shrink: 0;
}

.tab-bar-scroll .unity-scroller {
    display: none;
    opacity: 0;
    height: 0;
    width: 0;
}

.tab-bar {
    flex-shrink: 0;
    min-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.tab-wrap {
    flex-shrink: 0;
    min-width: 0;
}

.tab-btn {
    flex-grow: 1;
    flex-shrink: 0;
    height: 30px;
    margin: 0;
    padding: 0 12px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    white-space: nowrap;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: var(--color-text-tab-idle);
    transition-property: background-color, color;
    transition-duration: 0.12s;
}

.tab-btn:hover {
    color: var(--color-text-hover);
    background-color: var(--color-tab-hover-bg);
}

.tab-btn.tab-active,
.tab-btn.tab-active:focus,
.tab-btn.tab-active:active {
    color: var(--color-accent);
    background-color: rgba(0, 0, 0, 0);
}

.tab-btn.tab-active:hover {
    color: var(--color-accent-hover);
    background-color: var(--color-tab-hover-bg);
}

.tab-underline {
    height: 2px;
    margin: 0 0 -1px 0;
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 0.12s;
}

.tab-underline.active {
    background-color: var(--color-accent);
}

/* ---------- Tab Content area ---------- */
.tab-content {
    background-color: var(--color-bg);
}

.tab-pane {
    background-color: var(--color-bg);
}

/* ===================================================================
 * 3. SKILLS TAB — master-detail
 * =================================================================== */
.skills-list-pane {
    width: 45%;
    min-width: 180px;
    border-right-width: 1px;
    border-right-color: var(--color-border-hard);
    background-color: var(--color-panel);
}

/* The full surface can contain hundreds of skills. SkillsTabController uses a fixed-height
 * ListView so only rows inside the viewport participate in layout while the window is resized. */
.skills-list-view {
    min-height: 0;
    background-color: var(--color-panel);
}

.skills-list-item {
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    flex-grow: 1;
    flex-shrink: 0;
}

.skills-detail-pane {
    flex-grow: 1;
    background-color: var(--color-panel);
}

.list-toolbar {
    height: 28px;
    padding: 4px 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-card-border);
    background-color: var(--color-panel);
}

.search-field {
    flex-grow: 1;
    height: 24px;
    margin: 0 4px 0 0;
}

.search-field > .unity-text-field__input {
    background-color: var(--color-input-bg);
    border-color: var(--color-card-border);
    border-radius: 4px;
    color: var(--color-text);
    font-size: 12px;
    padding: 0 8px;
}

.search-field > .unity-text-field__input:focus {
    border-color: var(--color-accent);
}

.mini-btn {
    height: 24px;
    margin: 0 0 0 4px;
    padding: 0 10px;
    font-size: 11px;
    background-color: var(--color-button-bg);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 4px;
    color: var(--color-text);
}

.mini-btn:hover {
    background-color: var(--color-button-hover);
}

.mini-btn:disabled {
    opacity: 0.35;
}

.skills-count-bar {
    padding: 4px 8px;
    font-size: 10px;
    color: var(--color-muted);
    background-color: var(--color-panel);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-card-border);
}

.category-header {
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 4px 8px;
    background-color: var(--color-panel);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-card-border);
    font-size: 11px;
    color: var(--color-text);
    flex-direction: row;
    align-items: center;
}

.category-header:hover {
    background-color: var(--color-card-bg-hover);
}

/* Painted by VectorGlyphs: a filled triangle in this element's color, right when closed, down when open. */
.disclosure {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    margin-right: 4px;
    color: var(--color-muted);
}

/* Toolbar icon buttons (VectorGlyphs.SetIcon): one square size, the glyph painted 14px in the secondary text color. */
.toolbar-glyph-btn {
    flex-shrink: 0;
    width: 24px;
    padding: 0;
    align-items: center;
    justify-content: center;
}

.toolbar-glyph {
    width: 14px;
    height: 14px;
    color: var(--color-text-secondary);
}

.cat-count {
    color: var(--color-muted);
    font-size: 10px;
    -unity-text-align: middle-right;
}

.skill-row {
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 5px 8px 5px 26px;
    font-size: 11px;
    color: var(--color-text);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.15);
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
}

.skill-row:hover {
    background-color: var(--color-card-bg-hover);
}

.skill-row.selected {
    background-color: var(--color-card-bg-selected);
}

.skill-row.selected .skill-row__name {
    color: var(--color-text-on-accent);
}

.skill-row__name {
    flex-grow: 1;
    font-size: 11px;
    -unity-text-align: middle-left;
    color: var(--color-text);
    margin: 0;
    padding: 0;
}

.risk-badge {
    margin-left: auto;
    font-size: 9px;
    padding: 1px 6px;
    border-width: 1px;
    border-color: var(--color-tint-error-border);
    border-radius: 8px;
    background-color: var(--color-tint-error);
    color: var(--color-error);
    -unity-text-align: middle-center;
}

/* Detail pane */
.detail-empty {
    flex-grow: 1;
    color: var(--color-muted);
    font-size: 11px;
    -unity-text-align: middle-center;
    padding: 20px;
    white-space: normal;
}

.detail-header {
    padding: 10px 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-card-border);
}

.skill-title {
    font-size: 13px;
    -unity-font-style: normal;
    color: var(--color-text);
    margin-bottom: 4px;
}

.skill-meta {
    flex-direction: row;
    margin-bottom: 6px;
}

.tag {
    font-size: 9px;
    padding: 1px 8px;
    border-radius: 10px;
    margin-right: 4px;
    background-color: var(--color-button-bg);
    color: var(--color-text-secondary);
    border-width: 1px;
    border-color: var(--color-card-border);
}

.tag-danger {
    background-color: var(--color-tint-error);
    color: var(--color-error);
    border-color: var(--color-tint-error-border);
}

.tag-async {
    background-color: var(--color-accent-dark);
    color: white;
    border-color: var(--color-accent-dark);
}

.skill-desc {
    font-size: 11px;
    color: var(--color-text-secondary);
    white-space: normal;
}

.detail-body {
    padding: 10px 12px;
}

.form-label {
    font-size: 10px;
    color: var(--color-text-secondary);
    -unity-font-style: normal;
    margin-bottom: 2px;
}

.json-editor {
    margin-bottom: 8px;
}

.json-editor > .unity-text-field__input {
    background-color: var(--color-input-bg);
    border-color: var(--color-input-border);
    border-radius: 6px;
    color: var(--color-text);
    font-size: 12px;
    padding: 8px 10px;
    min-height: 80px;
    white-space: normal;
}

.json-editor > .unity-text-field__input:focus {
    border-color: var(--color-accent);
}

.detail-actions {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.btn-primary {
    background-color: var(--color-accent-dark);
    color: var(--color-text-on-accent);
    border-width: 1px;
    border-color: var(--color-accent-dark);
    border-radius: 6px;
    padding: 0 16px;
    -unity-font-style: normal;
    height: 28px;
    margin: 0 6px 0 0;
}

.btn-primary:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
}

.btn-ghost {
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-text-secondary);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 6px;
    padding: 0 12px;
    height: 28px;
    margin: 0 6px 0 0;
}

.btn-ghost:hover {
    color: var(--color-text);
    border-color: var(--color-muted);
}

.result-block {
    margin-top: 4px;
}

.result-block > .unity-text-field__input {
    background-color: var(--color-input-bg);
    border-color: var(--color-input-border);
    border-radius: 6px;
    color: var(--color-success);
    font-size: 12px;
    padding: 8px 10px;
    min-height: 60px;
    white-space: normal;
}

.result-block.error > .unity-text-field__input {
    color: var(--color-error);
}

/* ===================================================================
 * 4. AI CONFIG TAB — agent brand cards
 * =================================================================== */
.config-scroll {
    padding: 10px;
}

/* Custom agent rows: the text field takes only the width left beside its button, which never shrinks. */
.agent-card .setting-row > TextField {
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    height: 24px;
    margin: 0;
}

.agent-card .setting-row > TextField > .unity-base-text-field__input {
    flex-grow: 1;
    margin: 0;
    padding: 0 8px;
    border-radius: 4px;
    -unity-text-align: middle-left;
}

/* Custom agent icon squares: click picks an image, right-click resets it (AIConfigTabController.MakeIconPickable). */
.agent-icon--pickable {
    cursor: link;
}

.agent-field-label {
    flex-shrink: 0;
    width: 44px;
    font-size: 11px;
    color: var(--color-text-secondary);
}

.agent-path {
    margin-top: 6px;
    font-size: 11px;
    color: var(--color-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.agent-card .setting-row > Button {
    flex-shrink: 0;
    min-width: 56px;
    margin-top: 0;
    margin-bottom: 0;
}

.agent-card {
    background-color: var(--color-card-bg);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 8px;
}

.agent-card-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.agent-icon {
    width: 28px;
    height: 28px;
    border-radius: 2px;
    margin-right: 8px;
}

.agent-icon.brand-claudecode  { background-color: #FFF8F4; }
.agent-icon.brand-codex       { background-color: #ffffff; }
.agent-icon.brand-antigravity { background-color: #ffffff; }
.agent-icon.brand-cursor      { background-color: #ffffff; }
.agent-icon.brand-opencode    { background-color: #ffffff; }
.agent-icon.brand-kimicode    { background-color: #121316; }
.agent-icon.brand-custom {
    background-color: var(--color-button-bg);
    -unity-text-align: middle-center;
    font-size: 18px;
    -unity-font-style: normal;
    color: var(--color-text-secondary);
}

.agent-name {
    flex-grow: 1;
    font-size: 12px;
    -unity-font-style: normal;
    color: var(--color-text);
}

.agent-status {
    font-size: 10px;
    padding: 2px 8px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 10px;
}

.agent-status.installed {
    background-color: var(--color-tint-success);
    border-color: var(--color-tint-success-border);
    color: var(--color-success);
}

.agent-status.not-installed {
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--color-card-border);
    color: var(--color-muted);
}

.agent-card-actions {
    flex-direction: row;
    margin: 0 -2px;
}

.agent-card-actions > .mini-btn {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    height: 22px;
    font-size: 11px;
    margin: 0 2px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.agent-card-actions > .mini-btn .unity-button__text {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.mini-btn.update {
    background-color: var(--color-button-bg);
    color: var(--color-text);
}

.mini-btn.install {
    background-color: var(--color-accent-dark);
    border-color: var(--color-accent-dark);
    color: var(--color-text-on-accent);
    -unity-font-style: normal;
}

.mini-btn.install:hover {
    background-color: var(--color-accent);
}

.mini-btn.uninstall {
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--color-tint-error-border);
    color: var(--color-error);
}

.mini-btn.uninstall:hover {
    background-color: var(--color-tint-error);
    color: var(--color-error);
}

/* ===================================================================
 * 5. HISTORY TAB
 * =================================================================== */
.history-root {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
}

.history-toolbar {
    height: 32px;
    padding: 5px 10px;
    background-color: var(--color-panel);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-card-border);
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.history-toolbar__spacer {
    flex-grow: 1;
}

.history-toolbar__toggle {
    margin-right: 6px;
}

.history-cache-warning {
    margin: 8px 10px 0 10px;
}

.history-undo-btn {
    align-self: flex-start;
    margin: 6px 10px 0 10px;
}

.history-autoclean {
    margin: 6px 10px 0 10px;
    flex-shrink: 0;
}

.autoclean-usage {
    margin-top: 4px;
    margin-left: 2px;
}

.autoclean-legacy-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.autoclean-legacy-row > .muted-label {
    flex-grow: 1;
}

.autoclean-actions {
    flex-direction: row;
    margin-top: 6px;
}

.history-body {
    flex-grow: 1;
    min-height: 0;
    padding: 8px 10px;
}

.history-agent-filter {
    flex-shrink: 0;
    margin-bottom: 6px;
}

.timeline-list {
    flex-grow: 1;
    min-height: 0;
}

.timeline-row {
    flex-direction: row;
    align-items: center;
    padding: 0 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-card-border);
}

.timeline-row--step {
    padding-left: 24px;
}

.timeline-row--checkpoint {
    background-color: var(--color-card-header-bg);
}

.timeline-row--reverted {
    opacity: 0.55;
}

.timeline-row__text {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    font-size: 11px;
    -unity-font-style: normal;
    color: var(--color-text);
}

.timeline-row--auto > .timeline-row__text {
    color: var(--color-muted);
}

.timeline-row__preview {
    flex-shrink: 0;
    margin-left: 4px;
}

.restore-preview {
    flex-shrink: 0;
    margin-top: 8px;
    padding: 8px 10px;
    background-color: var(--color-card-bg);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 3px;
}

.restore-preview__summary {
    font-size: 11px;
    color: var(--color-text);
}

.restore-preview__conflicts-title {
    margin-top: 6px;
}

.restore-preview__coverage {
    margin-top: 6px;
}

.restore-preview__actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 8px;
}

.restore-preview__actions > .mini-btn {
    margin-left: 4px;
}

.conflict-list {
    margin-top: 4px;
}

.conflict-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.conflict-row__target {
    flex-grow: 1;
    margin-left: 6px;
    font-size: 11px;
    color: var(--color-text);
}

.conflict-row__at {
    font-size: 10px;
    color: var(--color-muted);
}

.task-card {
    background-color: var(--color-card-bg);
    border-width: 1px;
    border-color: var(--color-border-hard);
    border-radius: 3px;
    padding: 8px 10px;
    margin-bottom: 6px;
}

.task-card.undone {
    opacity: 0.55;
}

.task-card__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.task-card__name {
    font-size: 11px;
    -unity-font-style: normal;
    color: var(--color-text);
}

.task-card__time {
    margin-left: auto;
    font-size: 10px;
    color: var(--color-muted);
}

.task-card__summary {
    font-size: 11px;
    color: var(--color-text-secondary);
    margin-bottom: 6px;
    white-space: normal;
}

.task-card__actions {
    flex-direction: row;
}

.task-card__actions > .mini-btn {
    margin-right: 4px;
}

.mini-btn.danger {
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--color-tint-error-border);
    color: var(--color-error);
}

.mini-btn.danger:hover {
    background-color: var(--color-tint-error);
    color: var(--color-error);
}

/* Square icon-only mini buttons (e.g. Analytics trash / refresh) */
.analytics-icon-btn {
    width: 22px;
    min-width: 22px;
    padding: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* Square icon-only mini buttons (e.g. Analytics trash / refresh) */
.analytics-icon-btn {
    width: 22px;
    min-width: 22px;
    padding: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* ===================================================================
 * 6. FOOTER — version + stats pill + segmented language
 * =================================================================== */
.footer {
    background-color: var(--color-chrome-bg);
    height: 26px;
    border-top-width: 1px;
    border-top-color: var(--color-border-hard);
    padding: 0 8px;
}

.version-tag {
    font-size: 10px;
    color: var(--color-muted);
    margin-right: 8px;
}

.stats-pill {
    height: 18px;
    padding: 0 3px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 9px;
    flex-direction: row;
    align-items: center;
}

.stat-item {
    flex-direction: row;
    align-items: center;
    margin: 0 5px;
}

.stat-icon {
    width: 10px;
    margin-right: 4px;
    font-size: 10px;
    color: var(--color-muted);
    -unity-text-align: middle-center;
}

.stat-icon.ok { color: var(--color-success); }

.stat-icon--pending {
    width: 6px;
    height: 6px;
    margin-left: 2px;
    margin-right: 6px;
    background-color: var(--color-muted);
    border-radius: 1px;
}

.stat-value {
    -unity-font-style: normal;
    color: var(--color-text);
    font-size: 10px;
    min-width: 14px;
    -unity-text-align: middle-right;
    margin-right: 2px;
}

.stat-value.busy {
    color: var(--color-warning);
}

.stat-label {
    font-size: 10px;
    color: var(--color-text-secondary);
    margin-right: 2px;
}

.stat-divider {
    width: 1px;
    height: 10px;
    background-color: var(--color-card-border);
    margin: 0 6px 0 0;
}

/* Segmented Language Switch */
.lang-segment {
    flex-direction: row;
    height: 18px;
    background-color: var(--color-input-bg);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 9px;
    padding: 0;
}

.lang-segment__seg {
    margin: 0;
    padding: 0 8px;
    min-width: 32px;
    height: 16px;
    font-size: 10px;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 8px;
    color: var(--color-text-secondary);
    transition-property: background-color, color;
    transition-duration: 0.2s;
}

.lang-segment__seg:hover {
    color: var(--color-text);
}

.lang-segment__seg.active {
    background-color: var(--color-accent);
    color: white;
    -unity-font-style: normal;
}

/* ===================================================================
 * 7. SETTINGS DRAWER — slide-in from right
 * =================================================================== */
.drawer-mask {
    background-color: rgba(0, 0, 0, 0.4);
    opacity: 0;
    display: none;
    transition-property: opacity;
    transition-duration: 0.18s;
}

.drawer-mask.open {
    display: flex;
    opacity: 1;
}

.drawer-mask.hidden {
    display: none;
}

.drawer {
    width: 320px;
    max-width: 100%;
    background-color: var(--color-drawer-bg);
    border-left-width: 1px;
    border-left-color: var(--color-border-hard);
    translate: 100% 0;
    display: none;
    transition-property: translate;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.drawer.open {
    display: flex;
    translate: 0 0;
}

.drawer-header {
    height: 36px;
    background-color: var(--color-chrome-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border-hard);
    padding: 0 10px;
    flex-direction: row;
    align-items: center;
}

.drawer-header__title {
    flex-grow: 1;
    font-size: 12px;
    -unity-font-style: normal;
    color: var(--color-text);
}

.drawer-body {
    padding: 10px;
    max-width: 100%;
    overflow: hidden;
}

.settings-group {
    margin-bottom: 12px;
    padding: 4px 12px 6px 12px;
    background-color: var(--color-card-bg);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 8px;
}

.settings-group-title {
    font-size: 10px;
    color: var(--color-muted);
    -unity-font-style: normal;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-card-border);
}

.setting-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
    min-width: 0;
}

.setting-row__label {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    font-size: 11px;
    color: var(--color-text);
    margin-right: 6px;
    min-width: 0;
}

.setting-row__field {
    width: 120px;
    height: 20px;
    margin: 0;
    flex-shrink: 0;
}

.setting-row__field-narrow {
    width: 80px;
    height: 20px;
    margin: 0;
    flex-shrink: 0;
}

.setting-row__unit {
    margin-left: 6px;
    font-size: 10px;
    color: var(--color-muted);
}

.setting-hint {
    font-size: 10px;
    color: var(--color-muted);
    margin: -2px 0 8px 0;
    white-space: normal;
    overflow: hidden;
}

/* AnalyticsTabController's "no rows" placeholder - overrides just the top/left margin
 * longhands, so margin-right/bottom still fall through from .setting-hint above. */
.setting-hint--table-empty {
    margin-top: 2px;
    margin-left: 4px;
}

.narrow-warning-banner {
    background-color: var(--color-tint-warning);
    border-width: 1px;
    border-color: var(--color-tint-warning-border);
    border-radius: 6px;
    padding: 4px 8px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.narrow-warning-text {
    font-size: 10px;
    color: var(--color-warning-text);
    white-space: normal;
    flex-grow: 1;
    flex-shrink: 1;
}

/* Font-independent light-bulb icon for Unity 2022 and Unity 6. */
.narrow-warning-icon {
    width: 16px;
    height: 18px;
    flex-shrink: 0;
    margin-right: 6px;
    position: relative;
}

.narrow-warning-icon__bulb {
    position: absolute;
    left: 4px;
    top: 1px;
    width: 9px;
    height: 10px;
    border-radius: 50%;
    background-color: #f5e7b2;
}

.narrow-warning-icon__base {
    position: absolute;
    left: 6px;
    top: 11px;
    width: 5px;
    height: 4px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: #f5e7b2;
    background-color: transparent;
}

/* ---------- Permissions / token level ---------- */
.token-level-section {
    margin: 2px 0 8px 0;
    padding: 10px 12px 8px 12px;
    background-color: var(--color-card-bg);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 8px;
}

.token-level-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.token-level-value {
    flex-shrink: 0;
    margin-left: 8px;
    padding: 2px 10px;
    border-radius: 10px;
    font-size: 11px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    background-color: rgba(255, 255, 255, 0.06);
    color: var(--color-text);
}

.token-level-value--minimal,
.token-level-badge--minimal {
    color: #10B981;
    background-color: rgba(16, 185, 129, 0.16);
    border-width: 1px;
    border-color: rgba(16, 185, 129, 0.36);
}

.token-level-value--standard,
.token-level-badge--standard {
    color: #38BDF8;
    background-color: rgba(56, 189, 248, 0.16);
    border-width: 1px;
    border-color: rgba(56, 189, 248, 0.36);
}

.token-level-value--full,
.token-level-badge--full {
    color: #FB923C;
    background-color: rgba(251, 146, 60, 0.16);
    border-width: 1px;
    border-color: rgba(251, 146, 60, 0.36);
}

.token-level-value--maximum,
.token-level-badge--maximum {
    color: #C084FC;
    background-color: rgba(192, 132, 252, 0.18);
    border-width: 1px;
    border-color: rgba(192, 132, 252, 0.40);
}

.token-level-value--custom,
.token-level-badge--custom {
    color: #94A3B8;
    background-color: rgba(148, 163, 184, 0.14);
    border-width: 1px;
    border-color: rgba(148, 163, 184, 0.32);
}

.token-slider-container {
    position: relative;
    margin: 6px 0 6px 0;
    height: 28px;
}

.token-level-slider-native {
    display: none;
}

.token-slider-track {
    flex-grow: 1;
    height: 28px;
    border-radius: 14px;
    background-color: #222226;
    cursor: slide-arrow;
}

.token-level-scale {
    flex-direction: row;
    justify-content: space-between;
    margin: 2px 2px 4px 2px;
}

.token-level-scale__label {
    color: var(--color-muted);
    font-size: 11px;
    -unity-text-align: middle-center;
    cursor: link;
    padding: 2px 6px;
    border-radius: 4px;
    transition-property: color, background-color;
    transition-duration: 0.12s;
}

.token-level-scale__label:hover {
    color: var(--color-text-hover);
    background-color: var(--color-tab-hover-bg);
}

.token-level-scale__label--minimal.token-level-scale__label--active { color: #10B981; }
.token-level-scale__label--standard.token-level-scale__label--active { color: #38BDF8; }
.token-level-scale__label--full.token-level-scale__label--active { color: #FB923C; }
.token-level-scale__label--maximum.token-level-scale__label--active { color: #C084FC; }
.token-level-scale__label--active { -unity-font-style: normal; }

.token-level-hint {
    margin-bottom: 4px;
}

.token-level-advanced {
    margin-top: 2px;
}

.token-level-advanced-body {
    margin: 2px 0 0 4px;
}

.token-level-control-row {
    margin-bottom: 3px;
}

.token-level-toggle {
    flex-shrink: 0;
    width: 32px;
    margin: 0 0 0 6px;
}

.token-level-disabled-hint {
    display: none;
    color: var(--color-warning);
}

.token-level-disabled-hint--visible {
    display: flex;
}

.token-level-maximum-effect {
    display: none;
    height: 0;
}

/* ---------- Shortcuts section (panel hotkeys) ---------- */
.shortcut-binding {
    flex-shrink: 0;
    margin-right: 6px;
    font-size: 10px;
    color: var(--color-text-secondary);
    -unity-text-align: middle-right;
}

.shortcut-binding--unset {
    color: var(--color-muted);
    -unity-font-style: italic;
}

.shortcut-capture-prompt {
    flex-grow: 1;
    margin-right: 6px;
    font-size: 11px;
    color: var(--color-accent);
    -unity-font-style: normal;
    -unity-text-align: middle-right;
}

.shortcut-preview {
    flex-grow: 1;
    margin-right: 6px;
    font-size: 11px;
    color: var(--color-text);
    -unity-font-style: normal;
    -unity-text-align: middle-right;
}

.shortcut-conflict {
    margin: 2px 0 0 0;
    font-size: 10px;
    color: var(--color-error);
    white-space: normal;
}

/* ===================================================================
 * 8. CARDS (legacy compat — used by some inner pieces) and Inputs
 * =================================================================== */
.card {
    background-color: var(--color-card-bg);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 3px;
    padding: 10px;
    margin-bottom: 8px;
}

.card-header {
    background-color: var(--color-card-header-bg);
    margin: -10px -10px 8px -10px;
    padding: 6px 10px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-card-border);
    flex-direction: row;
    align-items: center;
}

.section-title {
    font-size: 12px;
    -unity-font-style: normal;
    color: var(--color-accent);
}

.bold-label {
    -unity-font-style: normal;
    color: var(--color-text);
}

.muted-label {
    color: var(--color-muted);
    font-size: 11px;
    white-space: normal;
}

.accent-title { color: var(--color-accent); }
.muted-title  { color: var(--color-muted); }

.unity-text-field__input,
.unity-integer-field__input,
.unity-dropdown-field__input,
.unity-enum-field__input,
.unity-base-text-field__input,
.unity-base-popup-field__input {
    background-color: var(--color-input-bg);
    border-color: var(--color-input-border);
    color: var(--color-text);
    border-radius: 2px;
}

.unity-text-field__input:focus,
.unity-integer-field__input:focus,
.unity-base-text-field__input:focus {
    border-color: var(--color-input-focus);
}

/* ---------- Foldout (legacy) ---------- */
.unity-foldout__toggle {
    margin-left: 0;
    padding-left: 0;
}

.unity-foldout__content {
    margin-left: 12px;
    padding-top: 4px;
}

/* ---------- Spacing Helpers ---------- */
.space-xs { height: 4px; }
.space-sm { height: 8px; }
.space-md { height: 12px; }

/* ---------- Divider Helpers ---------- */
.divider-top {
    border-top-width: 1px;
    border-top-color: var(--color-card-border);
}

.divider-bottom {
    border-bottom-width: 1px;
    border-bottom-color: var(--color-card-border);
}

/* ---------- Global Notice Stack ---------- */

.global-notice-stack {
    flex-shrink: 0;
}

.version-update-banner {
    min-height: 32px;
    padding: 4px 6px 4px 10px;
    background-color: var(--color-tint-accent);
    border-width: 1px;
    border-color: var(--color-tint-accent-border);
    border-radius: 6px;
}

.version-update-banner.is-hidden {
    display: none;
}

.version-update-banner__message {
    min-width: 0;
    margin-right: 8px;
    color: var(--color-accent-text);
    font-size: 11px;
    white-space: normal;
}

.version-update-banner__now {
    flex-shrink: 0;
    margin-right: 4px;
}

.version-update-banner__view {
    flex-shrink: 0;
    margin-right: 4px;
}

.version-update-banner__dismiss {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
}

/* ---------- Pending Approval Banner (v1.9) ---------- */

.pending-banner {
    background-color: var(--color-tint-warning);
    border-width: 1px;
    border-color: var(--color-tint-warning-border);
    border-radius: 6px;
}

.pending-banner__header {
    padding: 4px 8px;
}

.pending-banner__title {
    -unity-font-style: normal;
    color: var(--color-warning-text);
    font-size: 11px;
}

.pending-banner__list {
    flex-direction: column;
    padding: 0 8px 6px 8px;
}

.pending-banner__card {
    background-color: var(--color-card-bg);
    border-width: 1px;
    border-color: var(--color-tint-warning-border);
    border-radius: 6px;
    padding: 6px 8px;
    margin-top: 4px;
    flex-direction: column;
}

.pending-banner__card-head {
    flex-direction: row;
    align-items: center;
}

.pending-banner__skill {
    color: var(--color-text);
    -unity-font-style: normal;
    font-size: 11px;
    flex-grow: 1;
}

.pending-banner__expires {
    color: var(--color-muted);
    font-size: 10px;
    margin-right: 6px;
}

.pending-banner__args {
    color: var(--color-muted);
    font-size: 10px;
    margin-top: 2px;
    white-space: normal;
}

.pending-banner__actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 4px;
}

.pending-banner__overflow {
    color: var(--color-muted);
    font-size: 10px;
    -unity-font-style: italic;
    margin-top: 4px;
    -unity-text-align: middle-center;
}

/* ---------- Analytics tab ---------- */
.analytics-summary {
    margin: 8px 8px 4px 8px;
}

.analytics-stat {
    background-color: var(--color-card-bg);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 8px;
    padding: 10px 12px;
    margin: 2px;
    min-width: 88px;
    flex-grow: 1;
    flex-direction: column;
    align-items: flex-start;
}

.analytics-stat__value {
    font-size: 18px;
    color: var(--color-text);
    -unity-font-style: normal;
}

.analytics-stat__value--warn {
    color: var(--color-warning);
}

.analytics-stat__label {
    font-size: 10px;
    color: var(--color-muted);
    margin-top: 2px;
}

.analytics-table {
    margin: 0 8px 2px 8px;
    background-color: var(--color-card-bg);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 8px;
}

.analytics-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-card-border);
}

.analytics-row--header {
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border-hard);
}

.analytics-row--header .analytics-cell {
    color: var(--color-muted);
    font-size: 9px;
    -unity-font-style: normal;
}

.analytics-row--warn .analytics-cell {
    color: var(--color-warning);
}

.analytics-cell {
    font-size: 11px;
    color: var(--color-text);
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-right: 6px;
    /* Always 0 - only flex-grow varies per cell (column weight), which stays inline in
     * AnalyticsTabController since it's computed from data at build time. */
    flex-basis: 0;
}

.analytics-cell--num {
    -unity-text-align: middle-right;
    padding-right: 8px;
}

/* Credit block — single GitHub icon button, right of the language segment */
.credit-block {
    margin-left: 6px;
}

.credit-block__icon {
    width: 16px;
    height: 16px;
    padding: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.credit-block__icon:hover {
    opacity: 0.85;
}

/* ===================================================================
 * EVALUATION TAB (EvaluationTabController) — existing tokens only, so
 * the light theme needs no extra values.
 * =================================================================== */
.eval-scroll {
    padding: 8px 10px;
}

.eval-header {
    margin-bottom: 2px;
}

.eval-activity {
    font-size: 10px;
    color: var(--color-warning);
    margin-left: 8px;
}

.eval-section {
    background-color: var(--color-card-bg);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 3px;
    padding: 8px 10px;
    margin-top: 8px;
}

.eval-section-title {
    font-size: 11px;
    color: var(--color-accent);
    margin-bottom: 6px;
}

.eval-section-head > .eval-section-title {
    margin-bottom: 0;
}

.eval-section-head {
    margin-bottom: 6px;
}

.eval-subtitle {
    font-size: 10px;
    color: var(--color-muted);
    margin-top: 10px;
    margin-bottom: 4px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-card-border);
}

.eval-row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    margin-bottom: 4px;
}

.eval-row--actions {
    flex-wrap: wrap;
}

.eval-row--actions > .mini-btn {
    margin: 0 4px 4px 0;
}

.eval-row-label {
    width: 120px;
    flex-shrink: 0;
    font-size: 11px;
    color: var(--color-text-secondary);
    white-space: normal;
    margin-right: 6px;
}

.eval-value {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 11px;
    color: var(--color-text);
    white-space: normal;
    margin-bottom: 2px;
}

.eval-hint {
    font-size: 10px;
    color: var(--color-muted);
    white-space: normal;
    margin-bottom: 4px;
}

.eval-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 60px;
    height: 20px;
    margin: 0 2px 0 0;
}

.eval-choice {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 80px;
    height: 20px;
    margin: 0;
}

.eval-confirm {
    background-color: var(--color-panel);
    border-left-width: 3px;
    border-left-color: var(--color-warning);
    padding: 6px 8px;
    margin: 2px 0 6px 0;
}

.mini-btn.eval-btn-primary {
    background-color: var(--color-accent-dark);
    border-color: var(--color-accent-dark);
    color: var(--color-text-on-accent);
}

.mini-btn.eval-btn-primary:hover {
    background-color: var(--color-accent);
}

.eval-copied {
    font-size: 10px;
    color: var(--color-success);
    white-space: normal;
    margin-bottom: 4px;
}

.eval-state--ok { color: var(--color-success); }
.eval-state--warn { color: var(--color-warning); }
.eval-state--error { color: var(--color-error); }

.eval-messages {
    margin-top: 2px;
}

.eval-message-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 2px;
}

.eval-message-head {
    font-size: 10px;
    color: var(--color-muted);
    margin-right: 6px;
}

.eval-message {
    font-size: 11px;
    white-space: normal;
    padding-left: 6px;
    margin-bottom: 2px;
    border-left-width: 2px;
    border-left-color: var(--color-card-border);
    color: var(--color-text-secondary);
}

.eval-message--ok {
    color: var(--color-success);
    border-left-color: var(--color-success);
}

.eval-message--problem {
    color: var(--color-error);
    border-left-color: var(--color-error);
}

.eval-message--notice {
    color: var(--color-warning);
    border-left-color: var(--color-warning);
}

.eval-list {
    margin-top: 2px;
    margin-bottom: 4px;
}

.eval-list-row {
    flex-direction: row;
    align-items: center;
    min-height: 18px;
    margin-bottom: 1px;
}

.eval-list-row__id {
    width: 90px;
    flex-shrink: 0;
    font-size: 11px;
    color: var(--color-text);
}

.eval-list-row--history > .eval-list-row__id {
    width: 170px;
}

.eval-list-row__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 11px;
    color: var(--color-text-secondary);
    white-space: normal;
}

.eval-list-subline {
    font-size: 10px;
    color: var(--color-muted);
    white-space: normal;
    margin-left: 90px;
    margin-bottom: 2px;
}

.eval-usage-editor {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-left: 90px;
    margin-bottom: 4px;
}

.eval-usage-editor__label {
    font-size: 10px;
    color: var(--color-text-secondary);
    margin-right: 4px;
}

.eval-usage-editor__field {
    width: 90px;
    height: 20px;
    margin: 0 8px 0 0;
}

/* ---------- History: checkpoint accordion ---------- */

.history-groups {
    flex-grow: 1;
    min-height: 0;
}

.history-group {
    flex-shrink: 0;
    margin-bottom: 6px;
    background-color: var(--color-card-bg);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 8px;
}

.history-group--pre {
    background-color: rgba(0, 0, 0, 0);
}

.history-group__header {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px 6px 8px;
}

.history-group__header:hover {
    background-color: var(--color-card-bg-hover);
}

.history-group__header > .disclosure {
    margin: 0 6px 0 0;
}

.history-group__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.history-group__line {
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.history-group__title {
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 13px;
    color: var(--color-text);
}

.history-group--pre > .history-group__header .history-group__title {
    color: var(--color-text-secondary);
}

.history-group__chip {
    flex-shrink: 0;
    margin-left: 6px;
    padding: 0 6px;
    font-size: 10px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--color-card-border);
    color: var(--color-muted);
}

.history-group__chip--restored {
    background-color: var(--color-tint-accent);
    border-color: var(--color-tint-accent-border);
    color: var(--color-accent-text);
}

.history-group__chip--undone {
    background-color: var(--color-tint-warning);
    border-color: var(--color-tint-warning-border);
    color: var(--color-warning-text);
}

.history-group__summary {
    margin-top: 2px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 11px;
    color: var(--color-text-secondary);
}

.history-group__count {
    flex-shrink: 0;
    margin: 0 8px;
    font-size: 11px;
    color: var(--color-text-secondary);
}

.history-group__preview-btn {
    flex-shrink: 0;
    border-color: var(--color-tint-accent-border);
    color: var(--color-accent-text);
}

.history-group__undo-btn {
    flex-shrink: 0;
    border-color: var(--color-tint-warning-border);
    color: var(--color-warning-text);
}

.history-group__body {
    padding: 4px 10px 8px 28px;
    border-top-width: 1px;
    border-top-color: var(--color-card-border);
}

.history-group__empty {
    padding: 6px 0;
    font-size: 11px;
    color: var(--color-muted);
}

.history-group .restore-preview {
    margin-top: 4px;
    margin-bottom: 6px;
}

.history-step {
    flex-direction: row;
    align-items: center;
    height: 22px;
}

.history-step--reverted {
    opacity: 0.5;
}

.history-step__dot {
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    border-radius: 3px;
    background-color: var(--color-muted);
}

.history-step__verb {
    flex-shrink: 0;
    margin-right: 6px;
    font-size: 12px;
    color: var(--color-text-secondary);
}

.history-step__target {
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 12px;
    color: var(--color-text);
}

.history-step__tag {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 8px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 11px;
    color: var(--color-muted);
}

.history-step__agent {
    flex-shrink: 0;
    margin-left: 8px;
    font-size: 11px;
    color: var(--color-warning-text);
}

.history-step__undone {
    flex-shrink: 0;
    margin-left: 6px;
    padding: 0 6px;
    font-size: 10px;
    border-radius: 8px;
    background-color: var(--color-tint-warning);
    color: var(--color-warning-text);
}

.history-step__time {
    flex-shrink: 0;
    margin-left: 8px;
    font-size: 11px;
    color: var(--color-muted);
}

.history-show-earlier {
    align-self: center;
    margin-top: 6px;
    margin-bottom: 6px;
}

/* ---------- Evaluation: four steps ---------- */

.ev-head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.ev-state {
    margin-left: 8px;
    padding: 1px 8px;
    font-size: 11px;
    color: var(--color-muted);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 10px;
}

.ev-state--active {
    color: var(--color-accent-text);
    background-color: var(--color-tint-accent);
    border-color: var(--color-tint-accent-border);
}

.ev-state--done {
    color: var(--color-success);
    background-color: var(--color-tint-success);
    border-color: var(--color-tint-success-border);
}

.ev-grow {
    flex-grow: 1;
}

.ev-env {
    margin-right: 6px;
    font-size: 11px;
    color: var(--color-text-secondary);
}

.ev-env--ok {
    color: var(--color-success);
}

.ev-env--warn {
    color: var(--color-warning-text);
}

.ev-card {
    flex-shrink: 0;
    margin-bottom: 10px;
    padding: 12px;
    background-color: var(--color-card-bg);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 8px;
}

.ev-card--done {
    border-color: var(--color-tint-success-border);
}

.ev-card--warn {
    background-color: var(--color-tint-warning);
    border-color: var(--color-tint-warning-border);
}

.ev-card__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.ev-card__title {
    font-size: 13px;
    color: var(--color-text);
}

.ev-step {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    font-size: 11px;
    -unity-text-align: middle-center;
    color: var(--color-accent-text);
    background-color: var(--color-tint-accent);
    border-width: 1px;
    border-color: var(--color-tint-accent-border);
    border-radius: 10px;
}

.ev-sub {
    margin-left: 8px;
    font-size: 11px;
    color: var(--color-muted);
}

.ev-hint {
    margin-bottom: 8px;
    font-size: 11px;
    color: var(--color-muted);
    white-space: normal;
}

.ev-intro {
    flex-shrink: 0;
    margin-bottom: 10px;
    padding: 10px 12px;
    background-color: var(--color-tint-accent);
    border-width: 1px;
    border-color: var(--color-tint-accent-border);
    border-radius: 8px;
}

.ev-intro__row {
    margin-bottom: 4px;
}

.ev-intro__k {
    width: 96px;
    flex-shrink: 0;
    font-size: 12px;
    color: var(--color-accent-text);
}

.ev-intro__v {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12px;
    color: var(--color-text);
    white-space: normal;
}

.ev-intro__hint {
    font-size: 11px;
    color: var(--color-text-secondary);
    white-space: normal;
}

.ev-score-row {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 8px;
}

.ev-score {
    font-size: 32px;
    color: var(--color-text);
}

.ev-score__den {
    margin-left: 6px;
    margin-bottom: 4px;
    font-size: 13px;
    color: var(--color-text-secondary);
}

.ev-grade {
    padding: 3px 10px;
    font-size: 12px;
    color: var(--color-text-secondary);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 12px;
}

.ev-grade--excellent,
.ev-grade--good {
    color: var(--color-success);
    background-color: var(--color-tint-success);
    border-color: var(--color-tint-success-border);
}

.ev-grade--pass {
    color: var(--color-warning);
    background-color: var(--color-tint-warning);
    border-color: var(--color-tint-warning-border);
}

.ev-grade--needs-work {
    color: var(--color-error);
    background-color: var(--color-tint-error);
    border-color: var(--color-tint-error-border);
}

.ev-bar {
    height: 8px;
    margin-bottom: 8px;
    overflow: hidden;
    background-color: var(--color-input-bg);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 4px;
}

.ev-bar__fill {
    height: 100%;
    background-color: var(--color-accent-dark);
    border-radius: 4px;
}

.ev-bar__fill--ok {
    background-color: var(--color-success);
}

.ev-meta {
    margin-bottom: 6px;
    font-size: 11px;
    color: var(--color-muted);
    white-space: normal;
}

.ev-verdict {
    margin-bottom: 8px;
    font-size: 12px;
    color: var(--color-text);
    white-space: normal;
}

.ev-lines {
    margin-bottom: 4px;
}

.ev-seg {
    flex-shrink: 0;
    margin-bottom: 10px;
    padding: 2px;
    background-color: var(--color-input-bg);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 6px;
}

.ev-seg__btn {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    height: 24px;
    margin: 0;
    padding: 0 8px;
    font-size: 12px;
    color: var(--color-text-secondary);
    background-color: transparent;
    border-width: 1px;
    border-color: transparent;
    border-radius: 4px;
}

.ev-seg__btn:hover {
    color: var(--color-text);
}

.ev-seg__btn.is-selected {
    color: var(--color-accent-text);
    background-color: var(--color-tint-accent);
    border-color: var(--color-tint-accent-border);
}

.ev-fields {
    margin-bottom: 4px;
}

.ev-picks {
    margin-bottom: 8px;
}

.ev-pick {
    margin-right: 12px;
    margin-bottom: 4px;
    font-size: 12px;
    color: var(--color-text-secondary);
}

.ev-prompt-box {
    max-height: 160px;
    margin-bottom: 8px;
    padding: 10px;
    background-color: var(--color-input-bg);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 6px;
}

.ev-prompt {
    font-size: 11px;
    color: var(--color-text-secondary);
    white-space: normal;
}

.ev-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 2px;
}

.ev-combo {
    margin-top: 4px;
    margin-bottom: 4px;
    font-size: 11px;
    color: var(--color-muted);
}

.ev-chip {
    height: 18px;
    margin-right: 4px;
    margin-bottom: 4px;
    padding: 0 7px;
    font-size: 11px;
    -unity-text-align: middle-center;
    color: var(--color-muted);
    border-width: 1px;
    border-color: var(--color-card-border);
    border-radius: 9px;
}

.ev-chip--done,
.ev-chip--pass {
    color: var(--color-success);
    background-color: var(--color-tint-success);
    border-color: var(--color-tint-success-border);
}

.ev-chip--current {
    color: var(--color-accent-text);
    background-color: var(--color-tint-accent);
    border-color: var(--color-tint-accent-border);
}

.ev-chip--partial {
    color: var(--color-warning);
    background-color: var(--color-tint-warning);
    border-color: var(--color-tint-warning-border);
}

.ev-chip--fail {
    color: var(--color-error);
    background-color: var(--color-tint-error);
    border-color: var(--color-tint-error-border);
}

.ev-history {
    margin-top: 4px;
}
